    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dist": "tsc -p tsconfig.dist.json",
    "cli": "npm run build:dist --silent && node dist/cli.js",
    "kit": "npm run build --silent && node build/kit/run.js",
    "prepare": "npm run build:dist --silent && npm run build:browser --silent",
    "prepublishOnly": "node tools/refuse-early-publish.mjs",
    "test": "npm run build --silent && node --test \"build/test/*.test.js\"",
    "test:source": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build:browser": "node tools/bundle-runtime.mjs && node tools/build-browser.mjs",
    "test:browser": "npm run build:browser --silent && node --test tools/browser.test.mjs"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "swipl-wasm": "8.0.6"
