{
  "name": "metta-node",
  "version": "0.0.1-alpha.0",
  "private": true,
  "comment": "Private until the package carries the engine tree it mounts: boot() reads engine, lib and every seat's control file out of the checkout, the way the Python package copies them under metta/_runtime at build time.",
  "type": "module",
  "description": "MeTTa in TypeScript on the PeTTa engine, in process over swipl-wasm",
  "license": "MIT",
  "homepage": "https://github.com/trueagi-io/PeTTa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trueagi-io/PeTTa.git",
    "directory": "extensions/node"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge.pl": "./bridge.pl"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bridge.pl",
    "example",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dist": "tsc -p tsconfig.dist.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run build --silent && node --test \"build/test/*.test.js\"",
    "test:source": "node --test \"test/*.test.ts\"",
    "kit": "npm run build --silent && node build/kit/run.js",
    "prepare": "npm run build --silent"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "swipl-wasm": "8.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^6.0.3"
  }
}
